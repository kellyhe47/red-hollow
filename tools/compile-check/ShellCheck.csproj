<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless compile check for the shell's UNITY-FREE layers (Host, Net-minus-NGO, SimEventTap),
    for agents working without a Unity editor: `dotnet build tools/compile-check/ShellCheck.csproj`.

    Stubs.cs stands in for the handful of Unity-side types those layers name (Vector2, HeroIntent,
    MatchViewBinder, INetWire). This catches syntax and type errors in host/session/net edits that
    would otherwise first surface in the owner's editor; it does NOT cover the uGUI-facing files
    (ShellBootstrap, ShellControls, views) or the EditMode tests — those still need Unity.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Stubs.cs" />
    <Compile Include="../../unity/RedHollow/Assets/GameSim/**/*.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Game/Host/HeroIntents.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Game/Host/HostLoop.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Game/Host/IMatchSimHost.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Game/Host/ISimHost.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Game/Host/MatchSession.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Game/Host/MatchSimHost.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Game/Host/MonsterAttack.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Game/Host/PartyRoster.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Game/Host/ClientPrediction.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Game/UI/SimEventTap.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Game/Net/ColonyMatchFactory.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Game/Net/HostedMatch.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Game/Net/INetTransport.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Game/Net/LoopbackNetTransport.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Game/Net/NetSession.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Game/Net/NetSessionConfig.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Game/Net/NetTransportFactory.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Game/Net/NgoNetTransport.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Game/Net/UgsServices.cs" />

    <!-- The EditMode test files that are sim/net-pure (Unity touched only through Time.timeScale
         and Debug.Log, stubbed above). These RUN here: `dotnet test tools/compile-check` executes
         the real T11 session suite and the T14 timing/non-goal suites headlessly. -->
    <Compile Include="../../unity/RedHollow/Assets/Tests/EditMode/T11_SessionTests.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Tests/EditMode/T14_TimingTests.cs" />
    <Compile Include="../../unity/RedHollow/Assets/Tests/EditMode/T14_NonGoalTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>

</Project>
