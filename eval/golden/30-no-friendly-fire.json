{
  "schema_version": 1,
  "id": "G-030",
  "name": "hero-attack-passes-allies-and-placeables",
  "why": "A Gunslinger shot whose line crosses an ally and a barricade before a monster damages only the monster; ally and barricade take zero damage.",
  "covers": ["B-019"],
