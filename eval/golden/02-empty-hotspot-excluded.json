{
  "schema_version": 1,
  "id": "G-002",
  "name": "empty-hotspot-excluded",
  "why": "A hotspot with 0 civilians is not an 'available' target; the monster must pass it for a farther valid one.",
  "covers": ["B-001"],
  "case_type": "negative_control",
  "traces_to": ["BRIEF-6", "DEC-003"],
  "defends_against": "Targeting ranks by distance only and lets monsters pile onto already-emptied hotspots.",
  "time_sensitive": false,
  "given": {
    "inputs": {
      "monster": { "id": "m1", "type": "shambler", "pos": [0, 0] },
      "candidates": [
        { "id": "hs_chapel", "kind": "hotspot", "pos": [2, 0], "civilians": 0 },
        { "id": "hs_saloon", "kind": "hotspot", "pos": [9, 0], "civilians": 5 }
      ]
    },
    "preexisting_state": {},
    "configuration": {},
    "clock": {}
  },
  "when": { "operation": "select_target", "input_refs": ["m1"] },
  "expect": {
    "exact": {
      "result": { "monster_id": "m1", "target_id": "hs_saloon", "distance": 9.0 },
      "state_changes": [
        { "entity": "m1", "field": "target_id", "from": null, "to": "hs_saloon" }
      ],
      "emitted_events": [],
      "external_calls": []
    },
    "properties": []
  }
}
