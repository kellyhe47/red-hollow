{
  "schema_version": 1,
  "id": "G-010",
  "name": "last-kill-completes-wave",
  "why": "Killing the last living monster of wave 3 of 10 completes the wave, pays the bounty, and returns to planning; it must not declare victory.",
  "covers": [
    "B-006",
    "B-007"
  ],
  "case_type": "happy",
  "traces_to": [
    "BRIEF-1",
    "DEC-004",
    "DEC-005",
    "AUD-1"
  ],
  "defends_against": "Wave completion checked against spawned-count instead of living-count, or any wave clear declared as map victory.",
  "time_sensitive": false,
  "given": {
    "inputs": {
      "kill": {
        "monster_id": "m7",
        "monster_type": "ravager",
        "bounty": 15,
        "killer_hero_id": "hero_a"
      }
    },
    "preexisting_state": {
