{
  "schema_version": 1,
  "id": "G-005",
  "name": "burrower-ignores-barricade",
  "why": "The Burrower's identity is bypassing static defense; it must target the hotspot even when a barricade blocks the surface path, and ignore heroes.",
  "covers": ["B-003"],
  "case_type": "happy",
  "traces_to": ["DEC-007", "AUD-5"],
  "defends_against": "Burrower reuses generic targeting and gets stuck on barricades or distracted by heroes.",
  "time_sensitive": false,
  "given": {
    "inputs": {
      "monster": { "id": "m9", "type": "burrower", "pos": [0, 0] },
      "candidates": [
        { "id": "hero_a", "kind": "hero", "pos": [1, 0], "alive": true },
        { "id": "hs_saloon", "kind": "hotspot", "pos": [10, 0], "civilians": 8 }
      ],
      "blockers": [
        { "id": "bar_1", "kind": "barricade", "pos": [5, 0], "hp": 300, "blocks_path_between": ["m9", "hs_saloon"] }
      ]
    },
    "preexisting_state": {},
    "configuration": {},
    "clock": {}
  },
  "when": { "operation": "select_target", "input_refs": ["m9"] },
  "expect": {
    "exact": {
      "result": { "monster_id": "m9", "target_id": "hs_saloon", "distance": 10.0 },
      "state_changes": [
        { "entity": "m9", "field": "target_id", "from": null, "to": "hs_saloon" }
      ],
      "emitted_events": [],
      "external_calls": []
    },
    "properties": []
  }
}
