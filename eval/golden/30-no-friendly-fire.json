        { "id": "m1", "kind": "monster", "type": "shambler", "pos": [8, 0], "hp": 60, "alive": true }
      ]
    },
    "preexisting_state": {},
    "configuration": { "friendly_fire": false },
    "clock": {}
  },
  "when": { "operation": "resolve_hero_attack", "input_refs": ["hero_gun"] },
  "expect": {
