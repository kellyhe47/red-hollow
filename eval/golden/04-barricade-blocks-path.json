      ],
      "blockers": [
        { "id": "bar_1", "kind": "barricade", "pos": [5, 0], "hp": 300, "blocks_path_between": ["m1", "hs_saloon"] }
      ]
    },
    "preexisting_state": {},
    "configuration": {},
    "clock": {}
  },
  "when": { "operation": "select_target", "input_refs": ["m1"] },
  "expect": {
    "exact": {
      "result": { "monster_id": "m1", "target_id": "bar_1", "distance": 5.0 },
      "state_changes": [
        { "entity": "m1", "field": "target_id", "from": null, "to": "bar_1" }
      ],
      "emitted_events": [],
      "external_calls": []
    },
    "properties": []
  }
